# ---------- 基础 ----------
ENV=dev # dev, test, prod
DEBUG=true

# ---------- 数据库 ----------
DB__HOST=localhost
DB__PORT=5432
DB__USER=quant_user
DB__PASSWORD=change-me
DB__NAME=quant_platform

# ---------- Redis ----------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0

# ---------- JWT 认证 ----------
# 生成方式: uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT__SECRET_KEY=change-me-run-secrets-token-hex-to-generate
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT__REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- 券商凭证加密(Fernet key) ----------
# 生成方式: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION__CREDENTIALS_KEY=change-me-run-fernet-generate-key-to-generate

# ---------- 大模型 API ----------
LLM__PROVIDER=claude
LLM__API_KEY=
LLM__MODEL=claude-sonnet-5
LLM__RATE_LIMIT_PER_MINUTE=10

# ---------- 交易执行(风控开关初始值) ----------
TRADING__ENABLED_DEFAULT=true

# ---------- 前端跨域 ----------
CORS_ORIGINS=["http://localhost:3000"]

# ---------- 行情拉取 ----------
KLINE_FETCH_INTERVAL_SECONDS=3
