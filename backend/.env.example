# ---------- Base ----------
ENV=dev
DEBUG=true

# ---------- Database ----------
DB__HOST=localhost
DB__PORT=5432
DB__USER=quant_user
DB__PASSWORD=change_me
DB__DATABASE=quant_platform

# ---------- Redis ----------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
REDIS__LATEST_PRICE_CACHE_TTL_SECONDS=604800

# ---------- JWT ----------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT__SECRET_KEY=change_me
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT__REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- Credential Encryption ----------
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPT__CREDENTIALS_KEY=change_me

# ---------- LLM / AI ----------
LLM__PROVIDER=deepseek
LLM__API_KEY=change_me
LLM__MODEL=deepseek-v4-pro
LLM__RATE_LIMIT_PER_MINUTE=10
LLM__MAX_AGENT_ROUNDS=5
LLM__MESSAGE_MAX_LENGTH=4096

# ---------- Trading ----------
TRADING__ENABLED_DEFAULT=true
TRADING__DEFAULT_BACKTEST_CAPITAL=1000000

# ---------- Backtest Worker ----------
BACKTEST_WORKER__MAX_MEMORY_MB=512
BACKTEST_WORKER__MAX_CPU_SECONDS=300
BACKTEST_WORKER__WORKER_TIMEOUT_SECONDS=305
BACKTEST_WORKER__PROCESS_JOIN_TIMEOUT=320

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000"]

# ---------- Misc ----------
KLINE_FETCH_INTERVAL_SECONDS=3
DEFAULT_PAGE_SIZE=20

# Optional fixed TDX endpoint. Recommended in Docker where automatic probing may fail.
MOOTDX_SERVER=
