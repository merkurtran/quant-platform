# 这里的变量名是平铺的(不带双下划线),和 backend/.env 里
# pydantic-settings 用的嵌套格式(DB__USER)是两套独立的东西,
# 互不影响,但值必须保持一致,否则 Python 代码和 Docker 里的 Postgres 实际密码会对不上

DB_USER=quant_user
DB_PASSWORD=change_me
DB_NAME=quant_platform

# Host bindings for the full container deployment.
BIND_HOST=127.0.0.1
API_PORT=8000
FRONTEND_PORT=3000

# These values are embedded into the frontend image during docker build.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/market

# Fixed TDX endpoint for the container network; replace it if the node becomes unavailable.
MOOTDX_SERVER=110.41.147.114:7709
